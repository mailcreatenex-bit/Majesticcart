# Copy to .env and fill in. The app refuses to boot without the secrets marked
# REQUIRED — a missing signing key discovered in production means every token
# ever issued is suspect.

NODE_ENV=development
PORT=3001

# Every process must run in IST. The monthly repurchase gate reads the calendar
# month, so a UTC container mis-buckets any order placed after 6:30pm.
TZ=Asia/Kolkata

DATABASE_URL=postgresql://majestic:majestic@localhost:5432/majestic?schema=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# REQUIRED, 32+ chars. Generate: openssl rand -base64 48
JWT_SECRET=
# REQUIRED, 32+ chars. Pepper for OTP hashes; kept out of the database so a
# dumped table cannot be brute-forced against a six-digit space.
OTP_PEPPER=
# REQUIRED. Encrypts payout bank details, UPI IDs and admin TOTP secrets at
# rest. Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_VERSION=1
# On rotation, move the previous key here so existing rows still decrypt.
# FIELD_ENCRYPTION_KEY_V1=

# Object storage for payment screenshots and the UPI QR.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=majestic-uploads
S3_ACCESS_KEY_ID=majestic
S3_SECRET_ACCESS_KEY=majestic123
S3_FORCE_PATH_STYLE=true

# SMS. Leave SMS_PROVIDER=console in development: OTPs print to the terminal
# instead of costing money. Production needs DLT registration, a registered
# sender ID and pre-approved templates.
SMS_PROVIDER=console
SMS_SENDER_ID=MJSTIC
SMS_ENDPOINT=
SMS_API_KEY=
SMS_OTP_TEMPLATE_ID=

# Storefront origin, used to build canonical URLs and referral links.
NEXT_PUBLIC_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Seeding
SEED_ADMIN_EMAIL=admin@majesticcart.in
SEED_ADMIN_PASSWORD=
